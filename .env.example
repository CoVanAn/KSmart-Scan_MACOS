# Copy sang .env va sua theo nhu cau, hoac export truc tiep truoc khi chay.
# (Server doc bien moi truong, khong tu load .env - dung: set -a; . ./.env; set +a; npm start)

# --- HTTP ---
HOST=127.0.0.1
PORT=3000

# --- Quet mang ---
SCAN_PORTS=554,8000,80,443,8080,8554,2020,37777
PORT_TIMEOUT=900
PORT_CONCURRENCY=300
HOST_CONCURRENCY=64
PING_CONCURRENCY=128
MAX_HOSTS=4096
USE_NMAP=1
# arp-scan chinh xac nhat nhung can sudo NOPASSWD. Khong co nut trong UI,
# chi bat duoc o day. Neu chay that bai se tu dong lui ve nmap.
USE_ARP_SCAN=0

# --- Luong video ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FRAG_DURATION=400000
STREAM_IDLE_TIMEOUT=8000
MAX_STREAM_SESSIONS=8
PROBE_TIMEOUT=12000
TRANSCODE_BITRATE=2000k
TRANSCODE_PRESET=ultrafast

# --- Bao mat ---
# Khoa ma hoa kho tai khoan (64 ky tu hex). De trong se tu sinh vao data/.cred.key
# Sinh khoa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRED_KEY=
DATA_DIR=./data
